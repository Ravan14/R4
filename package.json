{
  "name": "r4-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "R4 Aerospace & Defence — static marketing site, React + Vite + SSG",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "npm run serve",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/contrast.mjs && node scripts/verify-content.mjs",
    "measure": "node scripts/measure-design.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0"
  }
}
