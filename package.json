{
  "name": "r4-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "R4 Aerospace & Defence — static marketing site, React + Vite + SSG",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-content.mjs",
    "codemod": "node scripts/html-to-jsx.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
